{
  "name": "mono-deck",
  "version": "2.6.4",
  "description": "A local control studio for 15-key, 3-knob HID macro keyboards",
  "author": "MONO DECK",
  "private": true,
  "main": "src/main/main.cjs",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "vite --host 127.0.0.1",
    "build:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "build": "tsc --noEmit && vite build && npm run build:native",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "probe": "node scripts/probe-device.cjs",
    "package": "npm run build && electron-builder --win dir"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "node-hid": "3.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "latest",
    "electron": "45.3.2",
    "electron-builder": "latest",
    "typescript": "^5.9.3",
    "vite": "8.3.8"
  },
  "build": {
    "appId": "studio.monodeck.desktop",
    "productName": "MONO DECK",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/bin",
        "to": "native",
        "filter": [
          "*.exe"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/node-hid/**/*"
    ],
    "win": {
      "target": "dir",
      "icon": "assets/icon.ico",
      "signExecutable": false
    }
  }
}
